# Token from @BotFather. Required.
BOT_TOKEN=

# PostgreSQL DSN. Required. sslmode=disable is needed for a local server.
DATABASE_URL=postgres://ROLE:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable

# Telegram user IDs allowed to run admin commands, comma-separated.
# Example: 123456789,987654321
ADMIN_IDS=

# Minimum log level: debug|info|warn|error.
LOG_LEVEL=info
