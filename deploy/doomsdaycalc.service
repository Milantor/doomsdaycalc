# systemd unit for the bot. Service user has no shell. Secrets come from
# EnvironmentFile, kept outside the working dir.
[Unit]
Description=Doomsday Calculator Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=doomsdaycalc
Group=doomsdaycalc
WorkingDirectory=/opt/doomsdaycalc
ExecStart=/opt/doomsdaycalc/doomsdaycalc
EnvironmentFile=/etc/doomsdaycalc/env
Restart=on-failure
RestartSec=5

# Hardening. Bot has no file writes. Postgres runs on localhost.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
